# Copy to .env and fill in as needed. Loaded via godotenv by cmd/node,
# cmd/gateway, and cmd/ingest; values here override the relevant YAML config.

# cmd/node
# BOILERPULSE_NODE_ID=node-1
# BOILERPULSE_HTTP_ADDR=:8080
# BOILERPULSE_RAFT_ADDR=:9080
# BOILERPULSE_LOG_LEVEL=info
# BOILERPULSE_CONFIG=configs/node-1.yaml
# BOILERPULSE_DATA_DIR=./data/node-1

# cmd/gateway
# BOILERPULSE_GATEWAY_CONFIG=configs/gateway.yaml
# BOILERPULSE_GATEWAY_HTTP_ADDR=:8090

# cmd/ingest
# BOILERPULSE_INGEST_TARGET_URL=http://localhost:8090
# BOILERPULSE_INGEST_INTERVAL_SECONDS=5

# chaos/failure-injection admin server (internal/admin) + the gateway's
# /v1/admin/* proxy -- both share this one secret. Unset (the default)
# disables every admin endpoint (503), never falls back to open access.
# `make cluster` uses "dev-chaos-token" unless this is set. See
# docs/failure-testing.md.
# BOILERPULSE_ADMIN_TOKEN=dev-chaos-token
# BOILERPULSE_ADMIN_ADDR=:7080

# CORS: restricts Access-Control-Allow-Origin. Unset (the default) means
# "*" -- fine for local dev, wrong for a public deployment. Set on every
# node and the gateway before exposing this anywhere. See
# docs/deployment.md.
# BOILERPULSE_CORS_ORIGIN=https://boilerpulse.example.com
